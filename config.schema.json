{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aang-Airbender Phase 1 v1.2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "perception", "features", "pinch", "timing", "control", "debug"],
  "properties": {
    "config_version": {"const": 2},
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_hands", "min_hand_detection_confidence", "min_hand_presence_confidence", "min_tracking_confidence"],
      "properties": {
        "num_hands": {"const": 2},
        "min_hand_detection_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "min_hand_presence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "min_tracking_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palm_center_weights", "velocity_smoothing_alpha", "min_joint_angle_degrees", "max_curled_joint_angle_degrees", "min_valid_confidence"],
      "properties": {
        "palm_center_weights": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "exclusiveMinimum": 0}},
        "velocity_smoothing_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_joint_angle_degrees": {"type": "number", "exclusiveMinimum": 90, "maximum": 180},
        "max_curled_joint_angle_degrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 180},
        "min_valid_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "pinch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_ratio", "open_ratio"],
      "properties": {
        "closed_ratio": {"type": "number", "exclusiveMinimum": 0},
        "open_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose_stability_ms", "hand_loss_grace_ms", "reacquisition_stability_ms", "display_topology_check_ms"],
      "properties": {
        "pose_stability_ms": {"type": "integer", "minimum": 0},
        "hand_loss_grace_ms": {"type": "integer", "exclusiveMinimum": 0},
        "reacquisition_stability_ms": {"type": "integer", "minimum": 0},
        "display_topology_check_ms": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_euro_min_cutoff", "one_euro_beta", "one_euro_derivative_cutoff", "control_box"],
      "properties": {
        "one_euro_min_cutoff": {"type": "number", "exclusiveMinimum": 0},
        "one_euro_beta": {"type": "number", "minimum": 0},
        "one_euro_derivative_cutoff": {"type": "number", "exclusiveMinimum": 0},
        "control_box": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": {"type": "number", "minimum": 0, "maximum": 1},
            "top": {"type": "number", "minimum": 0, "maximum": 1},
            "right": {"type": "number", "minimum": 0, "maximum": 1},
            "bottom": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_every_n_frames", "state_transition_history_capacity"],
      "properties": {
        "render_every_n_frames": {"type": "integer", "minimum": 1},
        "state_transition_history_capacity": {"type": "integer", "minimum": 1}
      }
    }
  }
}
